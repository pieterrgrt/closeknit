# Restricted app role, subject to Row Level Security. `pnpm db:migrate` creates it.
DATABASE_URL="postgres://closeknit_web:closeknit-web@localhost:5432/closeknit"
# Owner role: runs migrations only. The running app never uses it.
DATABASE_OWNER_URL="postgres://closeknit:closeknit@localhost:5432/closeknit"
