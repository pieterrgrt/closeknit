{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src", "test", "drizzle.config.ts", "vitest.config.ts"]
}
