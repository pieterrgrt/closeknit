{
	"name": "@closeknit/db",
	"version": "0.0.1",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"dist",
		"migrations",
		"src"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"generate": "drizzle-kit generate && node ../../scripts/license-headers.js --fix migrations",
		"migrate": "node --env-file-if-exists=../../apps/web/.env src/migrate-cli.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@types/node": "^22",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
