# Copy to `.env` next to docker-compose.prod.yml. Never commit the result.
# Passwords end up inside connection URLs, so use letters and digits only:
#   openssl rand -hex 24

POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Public address of the app, without a trailing slash.
ORIGIN=https://closeknit.eu

# Contact address for Let's Encrypt (expiry warnings).
ACME_EMAIL=

# Where the DNS of the domains is hosted (the nameservers), for the wildcard
# certificate: infomaniak or hetzner. See docs/deploy.md for the token's rights.
DNS_PROVIDER=infomaniak
DNS_API_TOKEN=

# Only when another proxy on this server already uses ports 80 and 443
# (see "Behind an existing nginx" in docs/deploy.md). Leave out otherwise.
#CADDY_BIND=127.0.0.1
#CADDY_HTTP_PORT=18080
#CADDY_HTTPS_PORT=18443
