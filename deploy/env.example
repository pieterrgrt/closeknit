# Copy to `.env` next to docker-compose.prod.yml. Never commit the result.
# Passwords end up inside connection URLs, so use letters and digits only:
#   openssl rand -hex 24

POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Public address of the app, without a trailing slash.
ORIGIN=https://closeknit.eu

# Contact address for Let's Encrypt (expiry warnings).
ACME_EMAIL=

# API token that may edit the DNS zone of closeknit.eu, for the wildcard certificate.
HETZNER_API_TOKEN=

# Only when another proxy on this server already uses ports 80 and 443
# (see "Behind an existing proxy" in docs/deploy.md). Leave out otherwise.
#CADDY_BIND=127.0.0.1
#CADDY_HTTP_PORT=8080
#CADDY_HTTPS_PORT=8443
